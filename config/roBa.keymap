#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27
#define KEYS_R 5 6 7 8 9 17 18 19 20 21 29 30 31 32 33
#define THUMBS 16 28 34 35 36 37 38 39 40 41 42
#define LAYER_BASE        0
#define LAYER_DEFAULT_WIN 1
#define LAYER_SYMBOL      2
#define LAYER_NAV_NUM     3
#define LAYER_FUNCTION    4
#define LAYER_MOUSE       5
#define LAYER_SCROLL      6
#define LAYER_SYSTEM      7
#define LAYER_CLICK       8
#define LAYER_WINDOW_GESTURE 9
#define LAYER_TAB_GESTURE    10

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    require-prior-idle-ms = <125>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    require-prior-idle-ms = <0>;
};

&trackball { scroll-layers = <LAYER_SCROLL>; };

/ {
    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <300>;
        excluded-positions = <17 18 19 20 21>;
    };

    /*
     * Trackball gesture engine. Two instances of one reusable processor, one
     * per gesture layer. OS is detected at runtime from LAYER_DEFAULT_WIN.
     * Per-direction arrays are ordered <windows macos>.
     */
    gesture_window: gesture_window {
        compatible = "zmk,input-processor-trackball-gesture";
        #input-processor-cells = <0>;
        layer = <LAYER_WINDOW_GESTURE>;
        windows-layer = <LAYER_DEFAULT_WIN>;
        up-keys    = <LG(TAB) LC(UP)>;     /* 全体表示: Win+Tab / Mission Control */
        down-keys  = <LG(D)   LC(DOWN)>;   /* デスクトップ表示 / App Exposé */
        left-keys  = <LS(TAB) LS(TAB)>;    /* 前のアプリ (Shift+Tab) */
        right-keys = <TAB     TAB>;        /* 次のアプリ */
        left-mods  = <LALT    LGUI>;       /* 保持修飾: Alt / Cmd */
        right-mods = <LALT    LGUI>;
    };

    gesture_tab: gesture_tab {
        compatible = "zmk,input-processor-trackball-gesture";
        #input-processor-cells = <0>;
        layer = <LAYER_TAB_GESTURE>;
        windows-layer = <LAYER_DEFAULT_WIN>;
        up-keys    = <LC(T)   LG(T)>;      /* 新規タブ */
        down-keys  = <LC(W)   LG(W)>;      /* タブを閉じる */
        left-keys  = <LS(TAB) LS(TAB)>;    /* 前のタブ (Ctrl+Shift+Tab) */
        right-keys = <TAB     TAB>;        /* 次のタブ (Ctrl+Tab) */
        left-mods  = <LCTRL   LCTRL>;      /* 保持修飾: Ctrl (両OS) */
        right-mods = <LCTRL   LCTRL>;
    };

    /*
     * 接続先(BTプロファイル)切り替えと同時にOSモード(ベースレイヤー)を
     * 決定的に設定するマクロ。tog ではなく to を使うことで状態を確定させる。
     *   &bt_mac N : プロファイルNへ切替 + Macモード   (overlay全OFF)
     *   &bt_win N : プロファイルNへ切替 + Windowsモード (LAYER_DEFAULT_WIN ON)
     * ジェスチャエンジンも LAYER_DEFAULT_WIN の状態を見るため自動で追従する。
     */
    bt_mac: bt_mac {
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        bindings
            = <&to LAYER_BASE>
            , <&macro_param_1to2>
            , <&bt BT_SEL MACRO_PLACEHOLDER>;
    };

    bt_win: bt_win {
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        bindings
            = <&to LAYER_DEFAULT_WIN>
            , <&macro_param_1to2>
            , <&bt BT_SEL MACRO_PLACEHOLDER>;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LAYER_SYMBOL LAYER_NAV_NUM>;
            then-layer = <LAYER_FUNCTION>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ToSystemLayer {
            bindings = <&mo LAYER_SYSTEM>;
            key-positions = <41 40>;
        };

        sqt_in_symbol {
            bindings = <&kp SQT>;
            key-positions = <17 18>;
            layers = <LAYER_SYMBOL>;
        };

        esc_qw {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        esc_jk {
            bindings = <&kp ESC>;
            key-positions = <18 19>;
        };

        to_function {
            bindings = <&mo 4>;
            key-positions = <39 40>;
        };
    };

    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <50>;
        };

        scroll_encoder_win: scroll_encoder_win {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <50>;
        };

        td_ctrl_shift: td_ctrl_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_CTRL_SHIFT";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        mqe: mkp_quick_exit {
            compatible = "zmk,behavior-mkp-quick-exit";
            #binding-cells = <1>;
            layer = <LAYER_MOUSE>;
            timeout-ms = <500>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q         &kp W        &kp E         &kp R           &kp T                                      &kp Y                &lt LAYER_TAB_GESTURE U  &lt LAYER_WINDOW_GESTURE I  &lt LAYER_CLICK O  &lt 6 P
&hml LGUI A   &hml LALT S  &hml LCTRL D  &hml LSHIFT F   &kp G      &trans         &kp DELETE       &kp H                &hmr RSHIFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI MINUS
&kp Z         &kp X        &kp C         &kp V           &kp B      &kp LG(C)      &kp LG(V)        &kp N                &kp M          &kp COMMA     &kp DOT      &kp SLASH
&kp CAPSLOCK  &tog 1       &trans        &kp LEFT_SHIFT  &kp SPACE  &lt 2 TAB      &lt 3 BACKSPACE  &mt RIGHT_GUI ENTER                                            &kp LC(SPACE)
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        default_win {
            bindings = <
&trans  &trans                  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans
&trans  &trans                  &trans  &trans  &trans  &trans         &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans                  &trans  &trans  &trans  &kp LC(C)      &kp LC(V)  &trans  &trans  &trans  &trans  &trans
&trans  &tog LAYER_DEFAULT_WIN  &trans  &trans  &trans  &trans         &trans     &trans                          &kp LG(SPACE)
            >;

            sensor-bindings = <&scroll_encoder_win>;
        };

        SYMBOL {
            bindings = <
&kp EXCL      &kp AT         &kp HASH        &kp DLLR          &kp PRCNT                                      &kp CARET              &kp AMPS           &kp ASTRK        &kp LPAR          &kp RPAR
&kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3    &kp NUMBER_4      &kp NUMBER_5          &trans        &kp DQT    &kp N6                 &kp N7             &kp N8           &kp N9            &kp N0
&kp GRAVE     &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp SEMI      &kp COLON  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp BACKSLASH
&trans        &trans         &trans          &trans            &trans                &trans        &trans     &trans                                                                       &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        NAV_NUM {
            bindings = <
&kp CARET      &kp DLLR  &kp DOT       &kp ASTRK  &kp PLUS                            &kp PLUS  &kp MINUS  &kp ASTRK  &kp SLASH  &kp EQUAL
&kp BACKSLASH  &kp PIPE  &kp QUESTION  &kp EXCL   &kp AMPERSAND  &trans      &kp DEL  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans         &trans    &trans        &trans     &trans         &trans      &trans   &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
&trans         &trans    &trans        &trans     &trans         &trans      &trans   &trans                                     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4  &kp F5                      &kp F6            &kp F7  &kp F8  &kp F9        &kp F10
&trans  &kp F11  &kp F12  &trans  &trans  &trans      &trans  &trans            &trans  &trans  &trans        &trans
&trans  &trans   &trans   &trans  &trans  &trans      &trans  &trans            &trans  &trans  &kp C_VOL_DN  &kp C_VOL_UP
&trans  &trans   &trans   &trans  &trans  &trans      &trans  &mo LAYER_SYSTEM                                &kp CAPSLOCK
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans    &trans            &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mqe MB4  &mqe MB1  &tog LAYER_MOUSE  &mqe MB2  &mqe MB5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans            &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                          &tog LAYER_SCROLL
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &tog LAYER_SCROLL
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SYSTEM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt_mac 0     &bt_mac 1     &bt_win 2     &bt_mac 3     &bt_mac 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        CLICK {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans     &trans     &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB4   &mkp MB1   &trans  &mkp MB2   &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                   &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        WINDOW_GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        TAB_GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
