#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <dt-bindings/zmk/pointing.h>

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27
#define KEYS_R 5 6 7 8 9 17 18 19 20 21 29 30 31 32 33
#define THUMBS 16 28 34 35 36 37 38 39 40 41 42

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    require-prior-idle-ms = <125>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    require-prior-idle-ms = <125>;
};

&trackball { scroll-layers = <5>; };

/ {
    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <300>;
        excluded-positions = <18 20>;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ToSystemLayer {
            bindings = <&mo 6>;
            key-positions = <41 40>;
        };

        sqt_in_symbol {
            bindings = <&kp SQT>;
            key-positions = <17 18>;
            layers = <1>;
        };

        esc_qw {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <50>;
        };

        td_ctrl_shift: td_ctrl_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_CTRL_SHIFT";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        mqe: mkp_quick_exit {
            compatible = "zmk,behavior-mkp-quick-exit";
            #binding-cells = <1>;
            layer = <4>;
            timeout-ms = <500>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                        &kp W         &kp E         &kp R                            &kp T                                          &kp Y                &kp U          &kp I         &kp O        &kp P
&hml LGUI A                  &hml LALT S   &hml LCTRL D  &hml LSHIFT F                    &kp G      &kp LS(LG(S))      &kp DELETE       &kp H                &hmr RSHIFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI MINUS
&kp Z                        &kp X         &kp C         &kp V                            &kp B      &kp COLON          &kp RIGHT_ALT    &kp N                &kp M          &kp COMMA     &kp DOT      &kp SLASH
&td_ctrl_shift LSHIFT LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &td_ctrl_shift LEFT_SHIFT LCTRL  &kp SPACE  &lt 1 TAB          &lt 2 BACKSPACE  &mt RIGHT_GUI ENTER                                            &kp LC(SPACE)
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SYMBOL {
            bindings = <
&kp EXCL      &kp AT         &kp HASH        &kp DLLR          &kp PRCNT                                      &kp CARET              &kp AMPS           &kp ASTRK        &kp LPAR          &kp RPAR
&kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3    &kp NUMBER_4      &kp NUMBER_5          &trans        &kp COLON  &kp N6                 &kp N7             &kp N8           &kp N9            &kp N0
&kp GRAVE     &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp SEMI      &kp COLON  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp BACKSLASH
&trans        &trans         &trans          &trans            &trans                &trans        &mo 3      &trans                                                                       &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        NAV_NUM {
            bindings = <
&kp CARET      &kp DLLR  &kp DOT       &kp ASTRK  &kp PLUS                            &kp PLUS  &kp MINUS  &kp ASTRK  &kp SLASH  &kp EQUAL
&kp BACKSLASH  &kp PIPE  &kp QUESTION  &kp EXCL   &kp AMPERSAND  &trans      &kp DEL  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans         &trans    &trans        &trans     &trans         &trans      &trans   &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
&trans         &trans    &trans        &trans     &trans         &mo 3       &trans   &trans                                     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4  &kp F5                      &kp F6  &kp F7  &kp F8  &kp F9        &kp F10
&trans  &kp F11  &kp F12  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans        &trans
&trans  &trans   &trans   &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp C_VOL_DN  &kp C_VOL_UP
&trans  &trans   &trans   &trans  &trans  &trans      &trans  &mo 6                                 &kp CAPSLOCK
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mqe MB1  &trans  &mqe MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &tog 5
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &tog 5
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SYSTEM {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
